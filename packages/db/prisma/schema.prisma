datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  CREATOR
  ADMIN
  MASTER_ADMIN
  FINANCE_ADMIN
  COMMUNITY_MODERATOR
  SAFETY_SPECIALIST
  CUSTOMER_SUPPORT
  EDITORIAL_TEAM
  MARKETING_MANAGER
  PARTNERSHIP_MANAGER
  REGIONAL_ADMIN
  OPERATIONS_ADMIN
  BUSINESS_ADMIN
  MODERATOR
}

enum SubscriptionTier {
  NONE
  PLUS
  PREMIUM
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  DENIED
  INFO_REQUESTED
}

enum CreatorType {
  WRITER
  ILLUSTRATOR
  STUDIO
  ARTIST
  NOVELIST
}

enum SeriesStatus {
  ONGOING
  COMING_SOON
  SEASON_ENDED
  HIATUS
  NEW_SEASON_COMING
  COMPLETED
}

enum SeriesType {
  COMIC
  NOVEL
}

enum ChapterTier {
  FREE
  AD_SUPPORTED
  PREMIUM
}

enum CollaborationRole {
  Writer
  Illustrator
  Colorist
  Editor
  Studio
  PrimaryCreator
  Contributor
}

enum CollaborationPermission {
  READ_WORKSPACE
  WRITE_WORKSPACE
  ADMIN
}

enum TransactionType {
  RECHARGE
  PAYOUT
  GIFT
  GIFT_SENT
  GIFT_RECEIVED
  PREMIUM_ACCESS
  REDEEM_CODE
}

enum LedgerType {
  RECHARGE
  GIFT_SENT
  GIFT_RECEIVED
  UNLOCK
  PAYOUT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum CollabAuditAction {
  INVITATION_SENT
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  INVITATION_CANCELLED
}

model User {
  id                        String           @id @default(uuid())
  email                     String           @unique
  username                  String           @unique
  avatarUrl                 String?
  role                      UserRole         @default(USER)
  subscription              SubscriptionTier @default(NONE)
  subscriptionExpiresAt     DateTime?
  isPromotionalSubscription Boolean          @default(false)
  hasAnimatedPfp            Boolean          @default(false)
  wCoinBalance              Int              @default(0)
  payoutBalance             Int              @default(0)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  emailVerified             Boolean          @default(false)
  phoneVerified             Boolean          @default(false)

  realName    String?
  payoutEmail String?
  taxId       String?

  creatorProfiles     CreatorProfile[]
  creatorApplications CreatorApplication[]
  readingHistory      ReadingHistory[]
  bookmarks           Bookmark[]
  transactions        Transaction[]
  redemptions         Redemption[]
  reportsSubmitted    SafetyReport[]            @relation("Reporter")
  collaborations      Collaboration[]
  follows             Follow[]                  @relation("Follower")
  membershipSubscriptions UserMembershipSubscription[]
  likes               Like[]
  comments            Comment[]
  sentInvitations     CollaborationInvitation[] @relation("InvitationSender")
  receivedInvitations CollaborationInvitation[] @relation("InvitationReceiver")
  collabAuditLogs     CollaborationAuditLog[]   @relation("CollabAuditActor")
  creatorPostComments CreatorPostComment[]
  creatorPostLikes    CreatorPostLike[]
  creatorPostBookmarks CreatorPostBookmark[]
  followedCreators    CreatorFollow[]
  notifications       Notification[]

  @@index([email])
}

model CreatorApplication {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          CreatorType
  penName       String
  bio           String?
  portfolioUrl  String
  status        ApplicationStatus @default(PENDING)
  reviewedById  String?
  reviewerNotes String?
  detailsJson   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
}

model CreatorProfile {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          CreatorType
  penName       String
  bio           String?
  portfolioUrl  String
  isVetted      Boolean     @default(false)
  monetized     Boolean     @default(false)
  followerCount Int         @default(0)
  viewCount     Int         @default(0)
  createdAt     DateTime    @default(now())

  monetizationStatus        String           @default("NOT_APPLIED")
  monetizationNotes         String?
  verificationStatus        String           @default("NOT_VERIFIED")
  verificationNotes         String?
  isFeatured                Boolean          @default(false)
  governmentId              String?
  businessVerification      String?

  series      Series[]
  membershipTiers           MembershipTier[]
  creatorGoals              CreatorGoal[]
  creatorNotifications      CreatorNotification[]
  studioStaff StudioStaff[] @relation("StaffCreator")
  studio      StudioStaff[] @relation("StudioCreator")
  creatorPosts              CreatorPost[]
  followers                 CreatorFollow[]

  @@index([userId])
}

model StudioStaff {
  id             String         @id @default(uuid())
  studioId       String
  studio         CreatorProfile @relation("StudioCreator", fields: [studioId], references: [id], onDelete: Cascade)
  staffId        String
  staff          CreatorProfile @relation("StaffCreator", fields: [staffId], references: [id], onDelete: Cascade)
  canViewFinance Boolean        @default(false)
  createdAt      DateTime       @default(now())

  @@unique([studioId, staffId])
}

model Series {
  id          String         @id @default(uuid())
  title       String
  description String
  coverUrl    String
  bannerUrl   String?
  genre       String         @default("Fantasy")
  type        SeriesType
  status      SeriesStatus   @default(ONGOING)
  statusMessage String?
  statusUpdatedAt DateTime   @default(now())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  views       Int            @default(0)
  likes       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  isProgressionPaused Boolean @default(false)
  progressionPausedAt DateTime?
  isInitiallyDistributed Boolean @default(false)

  adSystemEnabled Boolean @default(true)
  milestoneLocked Boolean @default(false)
  waitForFreeDays Int     @default(7)
  linkedSeriesId  String?

  chapters        Chapter[]
  collaborators   Collaboration[]
  bookmarks       Bookmark[]
  follows         Follow[]                  @relation("FollowedSeries")
  invitations     CollaborationInvitation[]
  collabAuditLogs CollaborationAuditLog[]
  notifications   Notification[]

  @@index([creatorId])
}

model Collaboration {
  id              String                  @id @default(uuid())
  seriesId        String
  series          Series                  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareRatio      Float
  role            CollaborationRole       @default(Contributor)
  permissions     CollaborationPermission @default(READ_WORKSPACE)
  roleDescription String?
  isAgreed        Boolean                 @default(false)
  agreedAt        DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now())

  @@unique([seriesId, userId])
  @@index([seriesId])
}

model Chapter {
  id             String      @id @default(uuid())
  seriesId       String
  series         Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  title          String
  chapterIndex   Int
  displayNumber  String      @default("1")
  sortKey        String      @default("000001.000000.000000.000000")
  tier           ChapterTier @default(FREE)
  waitTierDropAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  pages       Page[]
  textContent String?

  readingHistory ReadingHistory[]
  reports        SafetyReport[]
  comments       Comment[]

  @@unique([seriesId, chapterIndex])
  @@index([seriesId, sortKey])
}

model Comment {
  id            String   @id @default(uuid())
  chapterId     String
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String
  priorityScore Int      @default(0)
  stickerId     String?
  gifId         String?
  gifUrl        String?
  giftId        String?
  giftCredits   Int?     @default(0)
  giftTier      Int?     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([chapterId, priorityScore(Desc), createdAt(Desc)])
}

model Page {
  id        String  @id @default(uuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  pageIndex Int
  imageUrl  String
  width     Int?
  height    Int?

  @@unique([chapterId, pageIndex])
}

model ReadingHistory {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId        String
  chapter          Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  readAt           DateTime @default(now())
  timeSpentSeconds Int      @default(0)
  progressPct      Int      @default(0)

  @@unique([userId, chapterId])
  @@index([userId, readAt(Desc)])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId  String
  series    Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, seriesId])
}

model Follow {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("Follower", fields: [userId], references: [id], onDelete: Cascade)
  seriesId  String
  series    Series   @relation("FollowedSeries", fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, seriesId])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String
  createdAt DateTime @default(now())

  @@unique([userId, chapterId])
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCoins Int
  amountUsd   Int?
  type        TransactionType
  description String?
  createdAt   DateTime        @default(now())

  @@index([userId])
}

model PromoCode {
  id          String           @id @default(uuid())
  code        String           @unique
  isUsed      Boolean          @default(false)
  premiumDays Int              @default(30)
  tierGranted SubscriptionTier @default(PREMIUM)
  createdById String
  usedById    String?
  redemptions Redemption[]
  createdAt   DateTime         @default(now())
  expiresAt   DateTime?

  @@index([code])
}

model Redemption {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeId     String
  code       PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  redeemedAt DateTime  @default(now())

  @@unique([userId, codeId])
}

model SafetyReport {
  id              String   @id @default(uuid())
  reporterId      String
  reporter        User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  chapterId       String?
  chapter         Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  commentId       String?
  reason          String
  resolved        Boolean  @default(false)
  resolvedById    String?
  resolutionNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  staffUserId String
  action      String
  details     String
  createdAt   DateTime @default(now())
}

model CoinLedger {
  id                String     @id @default(uuid())
  transactionId     String     @default(uuid())
  sourceUserId      String?
  destinationUserId String?
  amount            Int
  type              LedgerType
  description       String?
  createdAt         DateTime   @default(now())

  @@index([sourceUserId])
  @@index([destinationUserId])
  @@index([transactionId])
}

model CollaborationInvitation {
  id              String            @id @default(uuid())
  seriesId        String
  series          Series            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User              @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId      String
  receiver        User              @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  role            CollaborationRole
  roleDescription String?
  shareRatio      Float
  message         String?
  terms           String?
  status          InvitationStatus  @default(PENDING)
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([seriesId])
  @@index([senderId])
  @@index([receiverId])
}

model CollaborationAuditLog {
  id        String            @id @default(uuid())
  seriesId  String
  series    Series            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User              @relation("CollabAuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action    CollabAuditAction
  details   String
  createdAt DateTime          @default(now())

  @@index([seriesId])
}

model MembershipTier {
  id               String                       @id @default(uuid())
  creatorProfileId String
  creatorProfile   CreatorProfile               @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  name             String
  description      String
  priceUsd         Float
  priceCoins       Int
  badgeUrl         String?
  colorTheme       String                       @default("#7c3aed")
  benefits         String                       @default("[]")
  isFeatured       Boolean                      @default(false)
  isPublished      Boolean                      @default(false)
  isArchived       Boolean                      @default(false)
  orderIndex       Int                          @default(0)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  subscriptions    UserMembershipSubscription[]
}

model UserMembershipSubscription {
  id               String                       @id @default(uuid())
  userId           String
  user             User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId           String
  tier             MembershipTier               @relation(fields: [tierId], references: [id], onDelete: Cascade)
  status           String                       @default("ACTIVE")
  paymentMethod    String                       @default("DIRECT")
  currentPeriodEnd DateTime
  autoRenew        Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([userId, tierId])
}

model CreatorGoal {
  id               String                       @id @default(uuid())
  creatorProfileId String
  creatorProfile   CreatorProfile               @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  title            String
  description      String
  type             String
  targetAmount     Int
  currentProgress  Int                          @default(0)
  reward           String
  endDate          DateTime?
  isPublic         Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
}

model CreatorNotification {
  id               String                       @id @default(uuid())
  creatorProfileId String
  creatorProfile   CreatorProfile               @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  userId           String?
  title            String
  message          String
  type             String
  isRead           Boolean                      @default(false)
  createdAt        DateTime                     @default(now())
}

model CreatorPost {
  id               String                 @id @default(uuid())
  creatorProfileId String
  creatorProfile   CreatorProfile         @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  title            String
  content          String                 @db.Text
  type             String                 @default("TEXT") // TEXT, ANNOUNCEMENT, CONCEPT_ART, POLL, QA, PROGRESS_UPDATE, MEMBERSHIP_EXCLUSIVE, etc.
  visibility       String                 @default("PUBLIC") // PUBLIC, FOLLOWERS_ONLY, MEMBERS_ONLY, TIER_ONLY
  allowedTierId    String?
  mediaUrls        String                 @default("[]") // JSON string array
  pollOptions      String                 @default("[]") // JSON string array for choices
  pollVotes        String                 @default("{}") // JSON string of user votes { "userId": choiceIndex }
  qaAnswers        String                 @default("[]") // JSON string of answers [ { "userId": "...", "answer": "..." } ]
  isPinned         Boolean                @default(false)
  status           String                 @default("PUBLISHED") // PUBLISHED, DRAFT, SCHEDULED, ARCHIVED
  scheduledFor     DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  viewsCount       Int                    @default(0)
  sharesCount      Int                    @default(0)
  tipsCount        Int                    @default(0)
  giftsCount       Int                    @default(0)
  
  comments         CreatorPostComment[]
  likes            CreatorPostLike[]
  bookmarks        CreatorPostBookmark[]
  
  @@index([creatorProfileId])
  @@index([status])
}

model CreatorPostComment {
  id               String                 @id @default(uuid())
  postId           String
  post             CreatorPost            @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  content          String                 @db.Text
  parentId         String?
  isPinned         Boolean                @default(false)
  isHearted        Boolean                @default(false)
  stickerId        String?
  gifId            String?
  gifUrl           String?
  giftId           String?
  giftCredits      Int?                   @default(0)
  giftTier         Int?                   @default(0)
  createdAt        DateTime               @default(now())

  @@index([postId])
  @@index([userId])
}

model CreatorPostLike {
  postId           String
  post             CreatorPost            @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model CreatorPostBookmark {
  postId           String
  post             CreatorPost            @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model CreatorFollow {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creatorProfile   CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([userId, creatorProfileId])
}

model AdminNotification {
  id        String   @id @default(uuid())
  userId    String?  // Optional: target specific user
  role      UserRole // Target administrative role
  title     String
  message   String
  priority  String   @default("Medium") // Low, Medium, High, Critical
  category  String   @default("System")
  isRead    Boolean  @default(false)
  deepLink  String?
  createdAt DateTime @default(now())

  @@index([role])
}

model RateLimit {
  key       String   @id
  count     Int
  resetTime DateTime
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorId String?
  seriesId  String?
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  type      String   @default("series_status") // "new_series" | "new_chapter" | "series_status"
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(Desc)])
  @@index([seriesId])
}

model StickerPack {
  id           String            @id @default(uuid())
  creatorId    String
  title        String
  description  String
  coverImage   String
  accessType   String            @default("FREE") // FREE, PAID, MEMBERSHIP, PLUS, PREMIUM
  price        Int               @default(0)
  status       String            @default("DRAFT") // DRAFT, REVIEW, PUBLISHED, ARCHIVED
  stickerCount Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  stickers      Sticker[]
  userLibraries UserPackLibrary[]

  @@index([creatorId])
  @@index([status])
  @@index([accessType])
}

model Sticker {
  id        String      @id @default(uuid())
  packId    String
  pack      StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  name      String      @default("")
  imageUrl  String
  animated  Boolean     @default(false)
  width     Int         @default(128)
  height    Int         @default(128)
  order     Int         @default(0)
  createdAt DateTime    @default(now())

  @@index([packId])
}

model UserPackLibrary {
  id        String      @id @default(uuid())
  userId    String
  packId    String
  pack      StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  source    String      @default("CLAIM") // PURCHASE, CLAIM, MEMBERSHIP, PLUS, PREMIUM
  expiresAt DateTime?
  createdAt DateTime    @default(now())

  @@unique([userId, packId])
  @@index([userId])
}

model FavoriteMedia {
  id        String   @id @default(uuid())
  userId    String
  mediaType String   // STICKER, GIF
  mediaId   String
  provider  String   @default("Panelva") // Panelva, Tenor
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  @@unique([userId, mediaType, mediaId])
  @@index([userId])
}

